NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Claude vision
ANTHROPIC_API_KEY=

# Razorpay
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Delivery: "manual" works with no credentials, switch to "porter" later
DELIVERY_PROVIDER=manual
PORTER_API_KEY=
PORTER_BASE_URL=https://pfe-apigw-uat.porter.in

# Shop config
NEXT_PUBLIC_SHOP_NAME=Thrift Shopper Store
# Public storefront URL used for product links shared from the admin dashboard.
# Falls back to https://store.indiarecycles.org if unset.
NEXT_PUBLIC_STORE_URL=https://store.indiarecycles.org

# Booking + UPI QR payment (customer pays by scanning, sends proof to team)
NEXT_PUBLIC_UPI_ID=
NEXT_PUBLIC_UPI_NAME=Thrift Shopper Store
# Seller WhatsApp number (digits incl. country code, no +) for "send proof" link
NEXT_PUBLIC_SELLER_WHATSAPP=
